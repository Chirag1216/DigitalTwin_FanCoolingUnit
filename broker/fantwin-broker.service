# Optional: run the broker automatically at login (systemd user service).
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp fantwin-broker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fantwin-broker
# Logs:  journalctl --user -u fantwin-broker -f

[Unit]
Description=Fan digital twin MQTT broker
After=network-online.target

[Service]
ExecStart=%h/Arduino/DigitalTwin_FanCoolongUnit/broker/start_broker.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
